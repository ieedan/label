{
	"name": "@label/monorepo",
	"version": "0.0.0",
	"description": "The monorepo for label",
	"license": "MIT",
	"packageManager": "pnpm@10.30.1",
	"type": "module",
	"scripts": {
		"start": "pnpm --filter @ieedan/label start",
		"build": "pnpm -r --filter './packages/*' build",
		"dev": "pnpm -r --parallel --filter './packages/*' dev",
		"lint": "biome lint --write",
		"format": "biome format --write",
		"check": "biome check --fix && pnpm type:check",
		"type:check": "pnpm -r check",
		"test": "pnpm -r test",
		"postinstall": "pnpm build:packages",
		"build:packages": "pnpm -r --filter './packages/*' build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
