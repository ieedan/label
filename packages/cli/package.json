{
	"name": "@ieedan/label",
	"description": "An issue labeler built on top of Jev.",
	"version": "0.0.0",
	"license": "MIT",
	"author": {
		"name": "Aidan Bleser",
		"url": "https://github.com/ieedan"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ieedan/label"
	},
	"bugs": {
		"url": "https://github.com/ieedan/label/issues"
	},
	"keywords": [
		"cli",
		"label",
		"jev",
		"github"
	],
	"type": "module",
	"bin": "./dist/bin.mjs",
	"main": "./dist/bin.mjs",
	"files": [
		"dist/**/*",
		"!dist/**/*.map"
	],
	"scripts": {
		"start": "node ./dist/bin.mjs",
		"build": "tsdown",
		"dev": "tsdown --watch",
		"check": "tsc --noEmit",
		"test": "vitest"
	},
	"packageManager": "pnpm@10.30.1",
	"dependencies": {
		"@ieedan/label-core": "workspace:*",
		"commander": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"nevereverthrow": "^0.3.0",
		"pathe": "^2.0.3",
		"picocolors": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vite": "^7.3.1",
		"vitest": "catalog:",
		"zod": "catalog:"
	}
}
